# Claude Code — repo-level backstop. The same rules live in config/git/ignore
# (the managed global ignore), but that is only active once install.sh has
# symlinked it, which is not true on a fresh clone. Keep both in sync.
.claude/settings.local.json
.claude/session-current.md
.claude/worktrees/

# Written into config/claude/ by other tools, not by this repo (ADR-048): the
# Claude app's account skill sync, which arrives through the ~/.claude/skills
# symlink, and a one-off transcript analysis.
config/claude/skills/synced/
config/claude/tools/
