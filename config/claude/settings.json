{
  "cleanupPeriodDays": 999,
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(make:*)",
      "Bash(docker compose:*)",
      "Bash(eza:*)",
      "Bash(bat:*)",
      "Bash(fd:*)",
      "Bash(fzf:*)",
      "Bash(rg:*)",
      "Bash(chmod:*)",
      "Bash(ln:*)",
      "Bash(ls:*)",
      "Bash(env:*)",
      "Bash(code:*)",
      "Bash(zed:*)",
      "WebSearch",
      "WebFetch",
      "Read(/Users/*/*)",
      "Glob(/Users/*/*)",
      "Grep(/Users/*/*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash $HOME/.claude/hooks/session-start.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"$CLAUDE_TOOL_ARG_FILE_PATH\" | grep -q 'ADR.md' && echo 'ADR.md was modified — update PRD.md to reflect the current state.' || true",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/bin/bash $HOME/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "linear@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {},
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "preferredNotifChannel": "terminal_bell",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "notifications": true
}
